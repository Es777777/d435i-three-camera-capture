# Publish project sources deliberately; keep collected data and local archives private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/启动数采.bat
!/software/
/software/*
!/software/.gitignore
!/software/*.py
!/software/*.bat
!/software/capture_config.yaml
!/software/points_blender52_final.json
!/software/requirements.txt
!/software/README.md
!/software/tools/
/software/tools/*
!/software/tools/*.py
!/software/tools/*.ps1
!/software/tools/runtime.json
!/software/tests/
/software/tests/*
!/software/tests/check_*.py
!/software/assets/
/software/assets/*
!/software/assets/calibration_target_70.png
!/docs/
/docs/*
!/docs/v*.md
!/docs/软件架构.md
!/hardware/
/hardware/*
!/hardware/calibration_target_70/
/hardware/calibration_target_70/*
!/hardware/calibration_target_70/*.stl
!/hardware/calibration_target_70/*.blend
!/hardware/calibration_target_70/fixed70_front.png
!/hardware/calibration_target_70/points_blender52_final.json

# Never commit environment credentials, keys, recordings, or generated caches.
**/.env
**/.env.*
**/*.pem
**/*.key
**/__pycache__/
**/*.pyc
**/.venv/
**/.runtime/
**/offline/
**/sessions/
**/telemetry/
**/logs/
